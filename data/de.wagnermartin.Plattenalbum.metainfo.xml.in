<?xml version="1.0" encoding="UTF-8"?>
<!-- Copyright (C) 2020-2026 Martin Wagner <martin.wagner.dev@gmail.com> -->
<component type="desktop-application">
  <id>de.wagnermartin.Plattenalbum</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Plattenalbum</name>
  <summary>Connect to your music</summary>
  <description>
    <p>A client for the Music Player Daemon (MPD).</p>
    <p>Browse your collection while viewing large album covers. Play your music without managing playlists.</p>
  </description>
  <launchable type="desktop-id">de.wagnermartin.Plattenalbum.desktop</launchable>
  <translation type="gettext">de.wagnermartin.Plattenalbum</translation>
  <url type="bugtracker">https://github.com/SoongNoonien/plattenalbum/issues</url>
  <url type="homepage">https://github.com/SoongNoonien/plattenalbum</url>
  <url type="vcs-browser">https://github.com/SoongNoonien/plattenalbum</url>
  <content_rating type="oars-1.1" />
  <developer id="wagnermartin.de">
    <name translate="no">Martin Wagner</name>
  </developer>
  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
    <control>touch</control>
  </supports>
  <branding>
    <color type="primary" scheme_preference="light">#ffd199</color>
    <color type="primary" scheme_preference="dark">#a34400</color>
  </branding>
  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/SoongNoonien/plattenalbum/v2.6.0/data/screenshots/main_window.png</image>
      <caption>Main window</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/SoongNoonien/plattenalbum/v2.6.0/data/screenshots/album_view.png</image>
      <caption>Album view</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/SoongNoonien/plattenalbum/v2.6.0/data/screenshots/search.png</image>
      <caption>Search</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/SoongNoonien/plattenalbum/v2.6.0/data/screenshots/small.png</image>
      <caption>Small window</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/SoongNoonien/plattenalbum/v2.6.0/data/screenshots/small_playlist.png</image>
      <caption>Small window with playlist</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/SoongNoonien/plattenalbum/v2.6.0/data/screenshots/small_cover.png</image>
      <caption>Small window with cover</caption>
    </screenshot>
  </screenshots>
  <releases>
    <release version="2.7.0" date="2026-09-10">
      <description translate="no">
        <ul>
          <li>Messages for MPD errors</li>
          <li>Added "as next" item to playlist menu</li>
          <li>Reworked desktop notifications</li>
          <li>New symbolic icon</li>
          <li>Fixed socket connection</li>
        </ul>
      </description>
    </release>
    <release version="2.6.0" date="2026-08-07">
      <description translate="no">
        <ul>
          <li>Improved playback mode menu</li>
          <li>Improved seeking with MPRIS</li>
          <li>Handle changing metadata in radio streams</li>
          <li>Allow manual socket connection</li>
          <li>Kazakh translation</li>
          <li>Removed scroll button</li>
          <li>Removed A-B-loop</li>
          <li>Many internal cleanups</li>
          <li>Minor bug fixes</li>
        </ul>
      </description>
    </release>
    <release version="2.5.0" date="2026-03-22">
      <description translate="no">
        <ul>
          <li>Reworked seek bar</li>
          <li>Polished server info dialog</li>
          <li>Skip button in notifications</li>
          <li>Minor cleanups</li>
        </ul>
      </description>
    </release>
    <release version="2.4.1" date="2026-01-03">
      <description translate="no">
        <ul>
          <li>Reduced flatpak permissions</li>
          <li>Empty state for artists</li>
          <li>Croatian translation</li>
        </ul>
      </description>
    </release>
  </releases>
</component>
